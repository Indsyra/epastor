flowchart TD
    subgraph FAIT["✅ DÉJÀ FAIT"]
        direction TB
        US01["US-01<br/>Schéma DB<br/>(10 tables)"]
        US02["US-02<br/>Seed pasteur<br/>idempotent"]
        US03["US-03<br/>Découverte vidéos<br/>(5652 réelles)"]
        US04["US-04<br/>Filtrage<br/>intervenant"]
        EXT1["target_tabs /<br/>source_tab<br/>(extension)"]
        EXT2["language<br/>sur Video<br/>(extension)"]
        US06["US-06<br/>Transcripts<br/>(fr/en + blocage)"]
        US08["US-08<br/>Chunking + embeddings<br/>+ FAISS (653 chunks réels)"]
        US09["US-09<br/>Agent LangGraph<br/>retrieval + génération"]
        US10["US-10<br/>Citations vidéo<br/>+ timestamp"]
        US35["US-35<br/>Scraping Shopify<br/>(93 livres réels)"]
        US11["US-11<br/>Extraction livres<br/>(rigueur validée, 0 faux positif)"]
        US22["US-22<br/>Idempotence, verrou<br/>+ scan incrémental"]
    end
    US01 --> US02 --> US03 --> US04 --> EXT1 --> EXT2 --> US06 --> US08 --> US09 --> US10 --> US35 --> US11 --> US22
    subgraph AVENIR["⏳ À VENIR"]
        direction TB
        US0507["US-05 / US-07<br/>Écrans de suivi"]
        EPICH["Epic H<br/>Synthèse<br/>multi-sources"]
        US31["US-31<br/>Garde-fous<br/>santé mentale"]
        EPICI["Epic I (suite)<br/>Mode général,<br/>conversation, relais humain"]
        EPICD["Epic D<br/>Formulaire<br/>opérateur"]
        EPICE["Epic E<br/>Widget +<br/>préférences"]
        EPICG["Epic G<br/>Orchestration +<br/>purge RGPD (P0)"]
    end
    US22 --> US31
    US31 --> US0507
    US31 --> EPICH
    EPICH --> EPICI
    EPICI --> EPICD
    EPICD --> EPICE
    EPICI -.déploiement réel.-> EPICG
    EPICE -.déploiement réel.-> EPICG
    classDef done fill:#2ecc71,stroke:#27ae60,color:#fff,font-weight:bold
    classDef next fill:#3498db,stroke:#2980b9,color:#fff,font-weight:bold
    classDef pending fill:#95a5a6,stroke:#7f8c8d,color:#fff
    classDef critical fill:#e74c3c,stroke:#c0392b,color:#fff,font-weight:bold
    classDef partial fill:#f39c12,stroke:#d68910,color:#fff,font-weight:bold
    class US01,US02,US03,US04,EXT1,EXT2,US06,US08,US09,US10,US35,US11,US22 done
    class US0507,EPICH,EPICI,EPICD,EPICE pending
    class US31 next
    class EPICG critical
